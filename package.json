{
  "name": "qrdatatransport",
  "version": "0.2.6",
  "description": "",
  "license": "Apache-2.0",
  "author": "hi2ma-bu4",
  "repository": {
    "type": "git",
    "url": "https://github.com/hi2ma-bu4/qrdatatransport.git"
  },
  "homepage": "https://github.com/hi2ma-bu4/qrdatatransport",
  "bugs": {
    "url": "https://github.com/hi2ma-bu4/qrdatatransport/issues"
  },
  "type": "module",
  "main": "./dist/QrDataTransport.js",
  "types": "./dist/QrDataTransport.d.ts",
  "exports": {
    ".": {
      "types": "./dist/QrDataTransport.d.ts",
      "import": "./dist/QrDataTransport.js"
    }
  },
  "scripts": {
    "build:wasm": "cargo component build --release --manifest-path wasm/protocol/Cargo.toml",
    "build:wasm:transpile": "jco transpile wasm/protocol/target/wasm32-wasip1/release/protocol.wasm -o src/wasm",
    "build:typecheck": "tsc --noEmit",
    "build:dts": "tsc -p tsconfig.build.json && node build/build-dts.mjs",
    "build:js": "node build/build.mjs",
    "build": "npm run build:wasm && npm run build:wasm:transpile && npm run build:typecheck && npm run build:js && npm run build:dts",
    "test:wasm": "cargo test --manifest-path wasm/protocol/Cargo.toml",
    "test:node": "tsx --test \"test/node/*.test.ts\"",
    "test": "npm run test:wasm && npm run test:node",
    "dev": "npx serve ."
  },
  "devDependencies": {
    "@bytecodealliance/jco": "~1.35.0",
    "@types/node": "^26.6.4",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "rollup": "^4.64.0",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "12.2.0"
  }
}
